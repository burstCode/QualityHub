        {
          "refId": "B",
          "expr": "max by (testid, endpoint) (k6_http_req_duration_p99{endpoint!=\"\"})",
          "legendFormat": "p99 {{endpoint}} ({{testid}})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true

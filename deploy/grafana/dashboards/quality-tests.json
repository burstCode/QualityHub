{
  "uid": "qh-quality",
  "title": "Качество тестирования и нагрузка",
  "tags": [
    "qualityhub"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Проект",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "qualityhub-db"
        },
        "query": "SELECT project_name FROM project WHERE project_is_active ORDER BY 1",
        "definition": "SELECT project_name FROM project WHERE project_is_active ORDER BY 1",
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "qualityhub"
      ],
      "asDropdown": false,
      "title": "Дашборды QualityHub",
      "icon": "external link",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Запусков за период",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qualityhub-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qualityhub-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS \"Запусков\" FROM v_run_summary WHERE $__timeFilter(test_run_started_at) AND project_name = '$project'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Средний pass rate, %",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qualityhub-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qualityhub-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(avg(pass_rate), 2) AS \"pass rate\" FROM v_run_summary WHERE $__timeFilter(test_run_started_at) AND project_name = '$project'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 97
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Упало тестов в последнем запуске",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qualityhub-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qualityhub-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT failed_count AS \"упало\" FROM v_run_summary WHERE project_name = '$project' ORDER BY test_run_started_at DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Длительность последнего запуска, с",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qualityhub-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qualityhub-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(test_run_duration_ms / 1000.0, 1) AS \"с\" FROM v_run_summary WHERE project_name = '$project' ORDER BY test_run_started_at DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Pass rate по запускам, %",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qualityhub-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qualityhub-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT test_run_started_at AS time, test_level_code AS metric, metric_value_value AS value FROM v_metric_series WHERE $__timeFilter(test_run_started_at) AND project_name = '$project' AND metric_code = 'pass_rate' ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Длительность запуска, с",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qualityhub-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qualityhub-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT test_run_started_at AS time, test_level_code AS metric, metric_value_value AS value FROM v_metric_series WHERE $__timeFilter(test_run_started_at) AND project_name = '$project' AND metric_code = 'duration' ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      }
    },
    {
      "type": "table",
      "title": "Последние запуски",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qualityhub-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qualityhub-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT test_run_started_at AS \"Начало\", test_level_code AS \"Уровень\", test_run_build_number AS \"Сборка\", test_run_branch AS \"Ветка\", total_count AS \"Всего\", passed_count AS \"Пройдено\", failed_count AS \"Упало\", skipped_count AS \"Пропущено\", pass_rate AS \"Pass rate, %\", round(test_run_duration_ms / 1000.0, 1) AS \"Длительность, с\" FROM v_run_summary WHERE $__timeFilter(test_run_started_at) AND project_name = '$project' ORDER BY test_run_started_at DESC LIMIT 20"
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Нагрузочные тесты (k6, данные в реальном времени из Prometheus, последний час)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Запросов в секунду",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (testid) (rate(k6_http_reqs_total[30s]))",
          "legendFormat": "{{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,

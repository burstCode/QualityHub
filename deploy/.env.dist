# Шаблон переменных окружения. Скопируйте в deploy/.env и задайте свои значения.

# --- PostgreSQL ---
POSTGRES_DB=qualityhub
POSTGRES_USER=qualityhub
POSTGRES_PASSWORD=change_me_pg
# Пароль пользователя Grafana (доступ только на чтение)
GRAFANA_DB_PASSWORD=change_me_ro
POSTGRES_PORT=5433

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
GRAFANA_PORT=3000
# Адрес привязки: 127.0.0.1 - только этот компьютер, 0.0.0.0 - вся сеть (docs/GUIDE.md, раздел 11)
GRAFANA_BIND=127.0.0.1

# --- Adminer ---
ADMINER_BIND=0.0.0.0
ADMINER_PORT=5050

# --- Prometheus ---
PROMETHEUS_PORT=9090
# Срок хранения метрик
PROM_RETENTION=30d

# --- k6 ---
# Адрес тестируемого приложения (приложение на хосте Docker Desktop: http://host.docker.internal:5210)
K6_BASE_URL=http://demo-target:8080
QH_PROJECT=demo
QH_ENV=local
# Тестовая учётная запись для сценариев ClinicWeb
CLINICWEB_LOGIN=
CLINICWEB_PASSWORD=

